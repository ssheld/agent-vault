#!/usr/bin/env bash

set -euo pipefail

zero_sha="0000000000000000000000000000000000000000"
config_key="agent-vault.allowMetadataOnlyMainPush"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  exit 0
fi

cd "$repo_root"

config_value=""
config_rc=0
config_value="$(git config --local --get --type=bool "$config_key" 2>/dev/null)" || config_rc=$?
if [[ "$config_rc" -ne 0 && "$config_rc" -ne 1 ]]; then
  echo "agent-vault main push gate failed." >&2
  echo "Invalid local git config value for $config_key; expected true or false." >&2
  exit 1
fi

if [[ "$config_value" != "true" ]]; then
  exit 0
fi

reject_main_push() {
  local reason="$1"

  echo "agent-vault main push gate failed." >&2
  echo "$reason" >&2
  echo "Use the PR flow for source, config, policy, hook, template, or mixed changes." >&2
  exit 1
}

push_remote="${1:-}"

reject_unverifiable_push() {
  local reason="$1" status="$2" missing_remote_commit="${3:-}" remotes remote

  echo "agent-vault main push gate failed." >&2
  echo "$reason (Git exit $status)." >&2
  if [[ -z "$missing_remote_commit" ]]; then
    echo "Inspect local Git errors and repository objects before retrying." >&2
    exit 1
  fi
  echo "Advertised remote main commit is unavailable locally: $missing_remote_commit." >&2
  # Without a named remote, Git passes the destination location in both hook
  # arguments. Never echo those arguments: URLs can contain credentials.
  if [[ -n "$push_remote" ]] && remotes="$(git remote 2>/dev/null)"; then
    while IFS= read -r remote; do
      if [[ "$remote" == "$push_remote" ]]; then
        printf 'Fetch main from the configured remote, then retry: git fetch -- %q main\n' "$remote" >&2
        echo "If fetching does not resolve this, inspect local Git errors and repository objects." >&2
        exit 1
      fi
    done <<<"$remotes"
  fi
  echo "Fetch main from the push destination, then retry." >&2
  echo "If fetching does not resolve this, inspect local Git errors and repository objects." >&2
  exit 1
}

runtime_note_classifier_loaded="false"

ensure_runtime_note_classifier() {
  if [[ "$runtime_note_classifier_loaded" == "true" ]]; then
    return 0
  fi

  if [[ ! -d "agent-vault" ]]; then
    reject_main_push "Tracked agent-vault directory is missing while $config_key is enabled."
  fi

  if [[ ! -f "agent-vault/_assets/hooks/lib/runtime-note.sh" ]]; then
    reject_main_push "Runtime metadata classifier is missing while $config_key is enabled."
  fi

  # shellcheck source=./lib/runtime-note.sh
  source "agent-vault/_assets/hooks/lib/runtime-note.sh"
  runtime_note_classifier_loaded="true"
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == "refs/heads/main" ]] || continue

  if [[ "$local_sha" == "$zero_sha" ]]; then
    reject_main_push "Direct deletion of main is not allowed."
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    reject_main_push "Direct creation of main is not allowed."
  fi

  ancestry_status=0
  git merge-base --is-ancestor "$remote_sha" "$local_sha" || ancestry_status=$?
  case "$ancestry_status" in
    0) ;;
    1) reject_main_push "Direct non-fast-forward push to main is not allowed." ;;
    *)
      missing_remote_commit=""
      if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        missing_remote_commit="$remote_sha"
      fi
      reject_unverifiable_push "Could not verify main push ancestry" "$ancestry_status" "$missing_remote_commit"
      ;;
  esac

  ensure_runtime_note_classifier

  # Check each commit, not just endpoint trees, so blocked files cannot be
  # changed and reverted inside the pushed range.
  # Capture results only after checking exit status: process substitutions
  # would silently accept empty or partial output from a failed Git command.
  inspection_status=0
  commits="$(git rev-list --reverse "$remote_sha..$local_sha")" || inspection_status=$?
  if [[ "$inspection_status" -ne 0 ]]; then
    reject_unverifiable_push "Could not enumerate commits for main push" "$inspection_status"
  fi
  blocked_files=()
  while IFS= read -r commit_sha; do
    [[ -n "$commit_sha" ]] || continue

    inspection_status=0
    parents="$(git rev-list --parents -n 1 "$commit_sha")" || inspection_status=$?
    if [[ "$inspection_status" -ne 0 ]]; then
      reject_unverifiable_push "Could not inspect parents of commit $commit_sha" "$inspection_status"
    fi
    read -r _commit first_parent _other_parents <<<"$parents"
    inspection_status=0
    if [[ -n "$first_parent" ]]; then
      changed_files="$(git diff --no-renames --name-only "$first_parent" "$commit_sha")" || inspection_status=$?
    else
      changed_files="$(git diff-tree --no-commit-id --name-only -r --no-renames --root "$commit_sha")" || inspection_status=$?
    fi
    if [[ "$inspection_status" -ne 0 ]]; then
      reject_unverifiable_push "Could not inspect files in commit $commit_sha" "$inspection_status"
    fi
    while IFS= read -r file_path; do
      [[ -n "$file_path" ]] || continue

      if ! is_runtime_note_file "$file_path"; then
        blocked_files+=("$file_path")
      fi
    done <<<"$changed_files"
  done <<<"$commits"

  if [[ "${#blocked_files[@]}" -gt 0 ]]; then
    echo "agent-vault main push gate failed." >&2
    echo "Direct push to main is allowed only for runtime agent-vault metadata." >&2
    echo "Blocked path(s):" >&2
    for file_path in "${blocked_files[@]}"; do
      echo "- $file_path" >&2
    done
    echo "Use the PR flow for source, config, policy, hook, template, or mixed changes." >&2
    exit 1
  fi
done
