#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  exit 0
fi

cd "$repo_root"

all_staged_files=()
while IFS= read -r file_path; do
  [[ -n "$file_path" ]] || continue
  all_staged_files+=("$file_path")
done < <(git diff --cached --name-only --diff-filter=ACDMRTUXB)

if [[ "${#all_staged_files[@]}" -eq 0 ]]; then
  exit 0
fi

# Non-blocking memory-budget warning: when memory files are staged and the
# budget checker is installed, surface any over-budget bucket/file in the STAGED
# commit content (the index, not the working tree) but never block the commit
# (the budget is advisory). Runs even when the metadata gate is skipped; silence
# with AGENT_VAULT_SKIP_MEMORY_BUDGET=1.
warn_memory_budget() {
  if [[ "${AGENT_VAULT_SKIP_MEMORY_BUDGET:-}" == "1" ]]; then
    return 0
  fi
  [[ -x scripts/check-memory-budget.sh ]] || return 0

  local touched_memory="false" file_path
  for file_path in "${all_staged_files[@]}"; do
    case "$file_path" in
      agent-vault/* | CLAUDE.md | GEMINI.md | AGENTS.md | */AGENTS.md)
        touched_memory="true"
        break
        ;;
    esac
  done
  [[ "$touched_memory" == "true" ]] || return 0

  # Measure the staged commit content by materializing the index into a temp dir.
  local staged_root budget_output budget_rc=0
  staged_root="$(mktemp -d "${TMPDIR:-/tmp}/agent-vault-budget-staged.XXXXXX")" || return 0
  if ! git checkout-index -a --prefix="$staged_root/" >/dev/null 2>&1; then
    rm -rf "$staged_root"
    return 0
  fi
  budget_output="$(scripts/check-memory-budget.sh --repo "$staged_root" --strict --format tsv 2>&1)" || budget_rc=$?
  rm -rf "$staged_root"

  # EXTERNAL is advisory even under --strict, so success alone cannot authorize
  # hiding scope exclusions. Never retarget absolute paths into this index copy
  # or read the working tree as a fallback for an excluded staged reference.
  if [[ "$budget_rc" -eq 0 ]] && ! printf '%s\n' "$budget_output" | awk -F '\t' '
    $1 == "IMPORT" && $3 == "EXTERNAL" { external = 1 }
    END { exit !external }
  '; then
    return 0
  fi

  echo "agent-vault memory-budget warning (non-blocking; staged content; set AGENT_VAULT_SKIP_MEMORY_BUDGET=1 to silence):" >&2
  printf '%s\n' "$budget_output" | awk -F '\t' '
    $1 == "IMPORT" && $3 ~ /^(EXTERNAL|INCOMPLETE|UNSUPPORTED)$/ {
      printf "  %s %s: %s\n", $3, $2, $5; next
    }
    $1 == "TOTAL" && $3 ~ /^(OVER|INCOMPLETE)$/ {
      printf "  %s %s: %s bytes; %s\n", $3, $2, $4, $5; next
    }
    $3 == "OVER" && !seen[$2]++ {
      printf "  OVER %s: %s bytes; %s\n", $2, $4, $5; next
    }
    NF != 5 && $0 != "" { print }
  ' >&2 || true
  echo "Run scripts/check-memory-budget.sh for the full report." >&2
  return 0
}

# Non-blocking context-log rollover warning: when agent-vault/context-log.md is
# staged and the rollover checker is installed, surface structural rollover
# problems in the STAGED content -- a stale duplicate "## Current Snapshot",
# leftover Git conflict markers, an empty handoff pointer -- but never block the
# commit. Runs even when the metadata gate is skipped; silence with
# AGENT_VAULT_SKIP_ROLLOVER_CHECK=1.
warn_context_log_rollover() {
  if [[ "${AGENT_VAULT_SKIP_ROLLOVER_CHECK:-}" == "1" ]]; then
    return 0
  fi
  [[ -x scripts/check-context-log-rollover.sh ]] || return 0

  local staged="false" file_path
  for file_path in "${all_staged_files[@]}"; do
    if [[ "$file_path" == "agent-vault/context-log.md" ]]; then
      staged="true"
      break
    fi
  done
  [[ "$staged" == "true" ]] || return 0

  # Validate the staged blob (the index, not the working tree).
  local tmp_file rollover_output rollover_rc=0 rollover_diagnostic
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/agent-vault-rollover-staged.XXXXXX")" || return 0
  if ! git show ":agent-vault/context-log.md" >"$tmp_file" 2>/dev/null; then
    rm -f "$tmp_file"
    return 0
  fi
  if rollover_output="$(scripts/check-context-log-rollover.sh "$tmp_file" --quiet 2>&1)"; then
    rm -f "$tmp_file"
    return 0
  else
    rollover_rc=$?
  fi
  rm -f "$tmp_file"

  echo "agent-vault context-log rollover warning (non-blocking; staged agent-vault/context-log.md; set AGENT_VAULT_SKIP_ROLLOVER_CHECK=1 to silence):" >&2
  # Status 1 is a validation finding; status 2 also covers usage/config/read
  # errors, not just unsupported Bash. Never guess the cause from the status.
  rollover_diagnostic="$rollover_output"
  if [[ "$rollover_rc" -eq 1 ]]; then
    rollover_diagnostic="$(printf '%s\n' "$rollover_output" | grep '^- ' || true)"
    [[ -n "$rollover_diagnostic" ]] || rollover_diagnostic="$rollover_output"
  fi
  if [[ "$rollover_diagnostic" == *[![:space:]]* ]]; then
    printf '%s\n' "$rollover_diagnostic" >&2
  else
    printf 'Checker exited %s without usable diagnostic output.\n' "$rollover_rc" >&2
  fi
  # This reflects the STAGED blob, which can differ from the working tree on a
  # partial-stage; point at the staged content, not the working-tree file.
  echo "The full report is on the STAGED content; inspect exactly what is staged with:" >&2
  echo "  git show :agent-vault/context-log.md >\"\${TMPDIR:-/tmp}\"/staged-context-log.md && scripts/check-context-log-rollover.sh \"\${TMPDIR:-/tmp}\"/staged-context-log.md" >&2
  return 0
}

warn_memory_budget
warn_context_log_rollover

if [[ "${AGENT_VAULT_SKIP_METADATA_GATE:-}" == "1" ]]; then
  exit 0
fi

if [[ ! -d "agent-vault" ]]; then
  for file_path in "${all_staged_files[@]}"; do
    if [[ "$file_path" == "agent-vault" || "$file_path" == agent-vault/* ]]; then
      echo "agent-vault metadata gate failed." >&2
      echo "Tracked agent-vault directory is missing while staged changes include agent-vault paths." >&2
      exit 1
    fi
  done

  exit 0
fi

if [[ ! -f "agent-vault/_assets/hooks/lib/runtime-note.sh" ]]; then
  echo "agent-vault metadata gate failed." >&2
  echo "Runtime metadata classifier is missing." >&2
  exit 1
fi

# shellcheck source=./lib/runtime-note.sh
source "agent-vault/_assets/hooks/lib/runtime-note.sh"

# Tests check marker integrity, equality, and caller behavior.
# BEGIN markdown fences
markdown_fences='
    function reset_fence() { fence_marker = ""; fence_length = 0; fence_line = 0 }
    function fenced(line, candidate, marker, run, tail) {
      candidate = line
      sub(/\r$/, "", candidate)
      sub(/^ ? ? ?/, "", candidate)
      marker = substr(candidate, 1, 1)
      run = 0
      if (marker == "`" || marker == "~") {
        while (substr(candidate, run + 1, 1) == marker) run++
      }
      tail = substr(candidate, run + 1)
      if (fence_marker != "") {
        if (marker == fence_marker && run >= fence_length && tail ~ /^[ \t]*$/) {
          fence_marker = ""
        }
        return 1
      }
      if (run < 3) return 0
      if (marker == "`" && index(tail, "`") != 0) return 0
      fence_marker = marker
      fence_length = run
      fence_line = FNR
      return 1
    }
    FNR == 1 { reset_fence() }
'
# END markdown fences

# Keep this trusted, static awk source identical in the pre-commit hook, the
# compactor, and the rollover checker, so all three order entries the same way.
# Tests check marker integrity, equality, and the conversion table.
# BEGIN entry timestamps
entry_timestamps='
    function days_in_month(y, m) {
      if (m == 2) return ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) ? 29 : 28
      if (m == 4 || m == 6 || m == 9 || m == 11) return 30
      return 31
    }
    # 1 when "YYYY-MM-DD HH:MM" names a real calendar minute. Anything else is
    # compared as written, never shifted.
    function real_minute(ts, y, mo, d) {
      y = substr(ts, 1, 4) + 0; mo = substr(ts, 6, 2) + 0; d = substr(ts, 9, 2) + 0
      if (mo < 1 || mo > 12 || d < 1 || d > days_in_month(y, mo)) return 0
      return (substr(ts, 12, 2) + 0 <= 23 && substr(ts, 15, 2) + 0 <= 59)
    }
    # Shift a real "YYYY-MM-DD HH:MM" minute by delta minutes, |delta| < 1440.
    function shift_minute(ts, delta, y, mo, d, total) {
      y = substr(ts, 1, 4) + 0; mo = substr(ts, 6, 2) + 0; d = substr(ts, 9, 2) + 0
      total = substr(ts, 12, 2) * 60 + substr(ts, 15, 2) + delta
      if (total < 0) {
        total += 1440; d--
        if (d < 1) { mo--; if (mo < 1) { mo = 12; y-- }; d = days_in_month(y, mo) }
      } else if (total >= 1440) {
        total -= 1440; d++
        if (d > days_in_month(y, mo)) { d = 1; mo++; if (mo > 12) { mo = 1; y++ } }
      }
      return sprintf("%04d-%02d-%02d %02d:%02d", y, mo, d, int(total / 60), total % 60)
    }
    # Zone token of an entry heading with its leading "### " removed.
    function entry_zone(heading, zone) {
      zone = substr(heading, 18)
      sub(/ .*$/, "", zone)
      return zone
    }
    # Minutes east of UTC for a usable numeric offset (-1200 through +1400), or
    # "unknown" for local, an abbreviation, or a numeric token outside that range.
    function offset_minutes(zone, hh, mm, total) {
      if (zone !~ /^[+-][0-9][0-9]([0-9][0-9])?$/) return "unknown"
      hh = substr(zone, 2, 2) + 0
      mm = (length(zone) == 5) ? substr(zone, 4, 2) + 0 : 0
      if (mm > 59) return "unknown"
      total = hh * 60 + mm
      if (substr(zone, 1, 1) == "-") total = -total
      if (total < -720 || total > 840) return "unknown"
      return total
    }
    # Earliest (which = -1) or latest (which = 1) UTC minute the heading can
    # name. A numeric offset gives one instant; an unknown offset spans every
    # usable offset, from 14:00 behind the written minute to 12:00 ahead of it.
    function entry_bound(heading, which, ts, off) {
      ts = substr(heading, 1, 16)
      if (!real_minute(ts)) return ts
      off = offset_minutes(entry_zone(heading))
      if (off == "unknown") return shift_minute(ts, (which < 0) ? -840 : 720)
      return shift_minute(ts, -off)
    }
    # Sort key for newest/oldest selection: the UTC minute for a numeric offset,
    # the written minute otherwise.
    function entry_key(heading, ts, off) {
      ts = substr(heading, 1, 16)
      off = offset_minutes(entry_zone(heading))
      if (off == "unknown" || !real_minute(ts)) return ts
      return shift_minute(ts, -off)
    }
'
# END entry timestamps

extract_context_log_frontmatter_value() {
  local file_path="$1"
  local field_name="$2"

  awk -v field_name="$field_name" '
    BEGIN {
      frontmatter_markers = 0
    }
    /^---$/ {
      frontmatter_markers += 1
      next
    }
    frontmatter_markers == 1 && index($0, field_name ":") == 1 {
      value = substr($0, length(field_name) + 2)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print value
      exit
    }
    frontmatter_markers >= 2 {
      exit
    }
  ' "$file_path"
}

extract_context_log_snapshot_last_updated() {
  local file_path="$1"

  awk "$markdown_fences"'
    { if (fenced($0)) next }
    /^## Current Snapshot$/ {
      in_snapshot = 1
      next
    }
    in_snapshot && /^## / {
      exit
    }
    in_snapshot && /^- Last updated:/ {
      value = $0
      sub(/^- Last updated:[[:space:]]*/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print value
      exit
    }
  ' "$file_path"
}

# Emit one line per entry under "## Entries": the written "YYYY-MM-DD HH:MM" for
# a valid heading, or a tagged line for a problem.
#
# Ordering runs two checks on each entry:
#   - Adjacent: against the entry directly above, when both carry a numeric
#     offset (compared by instant) or the same non-numeric token (compared by
#     written minute, the legacy rule; it cannot tell apart the repeated hour at
#     the end of daylight saving or two machines that both write `local`).
#   - Running bound: against every entry above. An entry is misordered when its
#     earliest possible instant is later than the lowest latest-possible instant
#     seen so far. This never rejects an order that could be valid, and it sees
#     past an unknown-offset entry sitting between two numeric-offset entries.
# A bound failure directly below another failure is the same misplacement seen
# again, so only the first of a run is reported.
collect_context_log_entry_timestamps() {
  local file_path="$1"

  awk "$markdown_fences$entry_timestamps"'
    { if (fenced($0)) next }
    /^## Entries$/ {
      in_entries = 1
      next
    }
    in_entries && /^## / {
      exit
    }
    in_entries && /^### / {
      if (match($0, /^### ([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]) (local|[A-Z][A-Za-z][A-Za-z]*|[+-][0-9][0-9]([0-9][0-9])?) - /)) {
        heading = $0
        sub(/^### /, "", heading)
        gsub(/\t/, " ", heading)
        written = substr(heading, 1, 16)
        zone = entry_zone(heading)
        numeric = (offset_minutes(zone) != "unknown")
        earliest = entry_bound(heading, -1)
        latest = entry_bound(heading, 1)

        adjacent_failure = 0
        bound_failure = 0
        if (entries > 0) {
          if (numeric && previous_numeric) adjacent_failure = (earliest > previous_latest)
          else if (!numeric && zone == previous_zone) adjacent_failure = (written > previous_written)
          bound_failure = (earliest > bound_latest)
        }
        if (adjacent_failure) {
          printf "__ORDER__\t%s\t%s\n", heading, previous_heading
        } else if (bound_failure && !previous_failed) {
          printf "__ORDER__\t%s\t%s\n", heading, bound_heading
        }
        previous_failed = (adjacent_failure || bound_failure)

        if (entries == 0 || latest < bound_latest) {
          bound_latest = latest
          bound_heading = heading
        }
        previous_heading = heading
        previous_written = written
        previous_zone = zone
        previous_numeric = numeric
        previous_latest = latest
        entries++

        if (entries == 1) printf "__TOP__\t%s\n", heading
        print written
        next
      }

      printf "__INVALID__\t%s\n", $0
    }
    END {
      if (fence_marker != "") {
        printf "__UNTERMINATED_FENCE__\t%d\n", fence_line
      }
    }
  ' "$file_path"
}

# Non-blocking: a newly added top entry should carry a numeric UTC offset, the
# only zone form the ordering checks can place exactly. History is left alone:
# a top entry already present in HEAD is never reported. Silence with
# AGENT_VAULT_SKIP_OFFSET_WARNING=1.
warn_context_log_entry_offset() {
  local file_path="$1"
  local top_heading="$2"
  local zone=""
  local head_log=""

  if [[ "${AGENT_VAULT_SKIP_OFFSET_WARNING:-}" == "1" || -z "$top_heading" ]]; then
    return 0
  fi

  zone="$(printf '%s\n' "$top_heading" | awk "$entry_timestamps"'
    { print (offset_minutes(entry_zone($0)) == "unknown") ? "unknown" : "numeric"; exit }
  ')" || return 0
  [[ "$zone" == "unknown" ]] || return 0

  # No HEAD (initial commit) or no log in HEAD means every entry is new. Read
  # the blob first: a pipeline would report an early grep exit as a failure.
  head_log="$(git show "HEAD:$file_path" 2>/dev/null)" || head_log=""
  if grep -Fqx -- "### $top_heading" <<<"$head_log"; then
    return 0
  fi

  echo "agent-vault context-log offset warning (non-blocking; set AGENT_VAULT_SKIP_OFFSET_WARNING=1 to silence):" >&2
  echo "  New top entry has no numeric UTC offset: \`$top_heading\`" >&2
  echo "  Entries from other zones cannot be ordered reliably against it. Write new headings with:" >&2
  echo "    date '+%Y-%m-%d %H:%M %z'" >&2
  return 0
}

validate_staged_context_log() {
  local file_path="$1"
  local tmp_file=""
  local first_date=""
  local top_heading=""
  local order_fields=""
  local last_updated=""
  local snapshot_last_updated=""
  local current_entry_line=""
  local has_entries="false"
  local -a errors=()

  tmp_file="$(mktemp "${TMPDIR:-/tmp}/agent-vault-context-log.XXXXXX")"
  trap 'rm -f "$tmp_file"; trap - RETURN' RETURN
  git show ":$file_path" >"$tmp_file" 2>/dev/null || {
    echo "Unable to read staged $file_path for validation."
    return 1
  }

  while IFS= read -r current_entry_line; do
    [[ -n "$current_entry_line" ]] || continue

    if [[ "$current_entry_line" == __UNTERMINATED_FENCE__* ]]; then
      errors+=("$file_path has an unterminated Markdown fence opened on line ${current_entry_line#*$'\t'}; entry and newest-first validation cannot see past it, so close the fence and recommit.")
      continue
    fi

    if [[ "$current_entry_line" == __ORDER__* ]]; then
      order_fields="${current_entry_line#*$'\t'}"
      errors+=("$file_path must keep entries newest-first; found newer entry \`${order_fields%%$'\t'*}\` below older entry \`${order_fields#*$'\t'}\`.")
      continue
    fi

    if [[ "$current_entry_line" == __TOP__* ]]; then
      top_heading="${current_entry_line#*$'\t'}"
      continue
    fi

    has_entries="true"

    if [[ "$current_entry_line" == __INVALID__* ]]; then
      errors+=("$file_path entry headings must start with \`YYYY-MM-DD HH:MM ±HHMM - <agent> - <topic>\` (local time and its numeric UTC offset, from \`date '+%Y-%m-%d %H:%M %z'\`; \`local\` or an abbreviation such as \`EDT\` is still accepted in place of the offset); found: ${current_entry_line#*$'\t'}")
      continue
    fi

    if [[ -z "$first_date" ]]; then
      first_date="${current_entry_line%% *}"
    fi
  done < <(collect_context_log_entry_timestamps "$tmp_file")

  if [[ "$has_entries" != "true" ]]; then
    errors+=("$file_path must include at least one entry under \`## Entries\`.")
  fi

  last_updated="$(extract_context_log_frontmatter_value "$tmp_file" "last_updated")"
  snapshot_last_updated="$(extract_context_log_snapshot_last_updated "$tmp_file")"

  if [[ -n "$first_date" && "$last_updated" != "$first_date" ]]; then
    errors+=("$file_path frontmatter \`last_updated\` must match the top entry date \`$first_date\`; found \`${last_updated:-<empty>}\`.")
  fi

  if [[ -n "$first_date" && "$snapshot_last_updated" != "$first_date" ]]; then
    errors+=("$file_path Current Snapshot \`Last updated\` must match the top entry date \`$first_date\`; found \`${snapshot_last_updated:-<empty>}\`.")
  fi

  trap - RETURN
  rm -f "$tmp_file"

  if [[ "${#errors[@]}" -eq 0 ]]; then
    warn_context_log_entry_offset "$file_path" "$top_heading"
    return 0
  fi

  printf '%s\n' "${errors[@]}"
  return 1
}

non_deleted_staged_files=()
while IFS= read -r file_path; do
  [[ -n "$file_path" ]] || continue
  non_deleted_staged_files+=("$file_path")
done < <(git diff --cached --name-only --diff-filter=ACMRTUXB)

has_context_log="false"
# Counted iteration is safe for an empty array under Bash 3.2 nounset. Do not
# skip the metadata gate: substantive deletion-only changes still require it.
for ((file_index = 0; file_index < ${#non_deleted_staged_files[@]}; file_index++)); do
  file_path="${non_deleted_staged_files[$file_index]}"
  if [[ "$file_path" == "agent-vault/context-log.md" ]]; then
    has_context_log="true"
    break
  fi
done

context_log_validation_failed="false"
context_log_validation_output=""

if [[ "$has_context_log" == "true" ]]; then
  context_log_validation_output="$(validate_staged_context_log "agent-vault/context-log.md" 2>&1)" || context_log_validation_failed="true"
fi

if [[ "$context_log_validation_failed" == "true" ]]; then
  echo "agent-vault metadata gate failed." >&2
  echo "Context log validation failed:" >&2
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    echo "- $line" >&2
  done <<<"$context_log_validation_output"
  exit 1
fi

# A passing validation can still carry a non-blocking warning.
if [[ -n "$context_log_validation_output" ]]; then
  printf '%s\n' "$context_log_validation_output" >&2
fi

requires_metadata_gate="false"
for file_path in "${all_staged_files[@]}"; do
  if ! is_runtime_note_file "$file_path"; then
    requires_metadata_gate="true"
    break
  fi
done

if [[ "$requires_metadata_gate" != "true" ]]; then
  exit 0
fi

has_daily_note="false"
has_design_log="false"

for ((file_index = 0; file_index < ${#non_deleted_staged_files[@]}; file_index++)); do
  file_path="${non_deleted_staged_files[$file_index]}"
  case "$file_path" in
    agent-vault/daily/*.md)
      if [[ "$file_path" != "agent-vault/daily/README.md" ]]; then
        has_daily_note="true"
      fi
      ;;
    agent-vault/design-log/*.md)
      if [[ "$file_path" != "agent-vault/design-log/README.md" && "$file_path" != "agent-vault/design-log/bootstrap.md" ]]; then
        has_design_log="true"
      fi
      ;;
  esac
done

missing_items=()
if [[ "$has_context_log" != "true" ]]; then
  missing_items+=("stage agent-vault/context-log.md")
fi
if [[ "$has_daily_note" != "true" ]]; then
  missing_items+=("stage one note under agent-vault/daily/")
fi
if [[ "$has_design_log" != "true" ]]; then
  missing_items+=("stage one note under agent-vault/design-log/")
fi

if [[ "${#missing_items[@]}" -eq 0 ]]; then
  exit 0
fi

echo "agent-vault metadata gate failed." >&2
echo "Substantive staged changes require baseline session artifacts before commit:" >&2
for item in "${missing_items[@]}"; do
  echo "- $item" >&2
done
echo >&2
echo "Also stage any conditionally required artifacts for this session:" >&2
echo "- agent-vault/open-questions.md" >&2
echo "- agent-vault/decision-log.md plus a decision record" >&2
echo "- agent-vault/context/handoffs/" >&2
echo "- agent-vault/lessons.md" >&2
echo >&2
echo "If this commit is intentionally trivial, bypass explicitly:" >&2
echo "AGENT_VAULT_SKIP_METADATA_GATE=1 git commit ..." >&2

exit 1
